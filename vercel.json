{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "cleanUrls": true,

  "rewrites": [
    {
      "source": "/resume",
      "destination": "/assets/resume.pdf"
    }
  ],

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
